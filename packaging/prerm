#!/bin/sh
set -e
if [ "$1" = remove ]; then
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke stop roccat-openrgb.service
    fi
    /usr/lib/roccat/system/desktop-starter remove
    deb-systemd-helper purge roccat-openrgb.service
    rm -rf --one-file-system -- /var/lib/roccat-openrgb
    if getent passwd roccat-openrgb >/dev/null; then
        deluser --system roccat-openrgb
    fi
    if getent group roccat-openrgb >/dev/null; then
        delgroup --system --only-if-empty roccat-openrgb
    fi
fi
