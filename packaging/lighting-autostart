#!/bin/sh
# roccat lighting activation | Version in VERSION | Josef Lehner | 24.11.2026
# Run as the desktop user. Backs up an existing profile-start unit and upgrades it
# in place by service name, preserving the existing script and all profiles.
# Returns nonzero on configuration, systemd or permission errors.
set -eu
[ "$(id -u)" -ne 0 ] || { echo "Als Desktop-Benutzer starten. / Run as the desktop user." >&2; exit 1; }
case "${1-}" in
    --help) echo "roccat-lichtdienst | Enable or migrate roccat-profil-start.service"; exit 0 ;;
    "") ;;
    *) exit 2 ;;
esac
root=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd -P)
unit=roccat-profil-start.service
directory="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
target="$directory/$unit"
source="$root/packaging/$unit"
[ -f "$source" ] || source="/usr/lib/systemd/user/$unit"
mkdir -p "$directory"
temp=$(mktemp "$directory/.roccat-XXXXXX")
trap 'rm -f -- "$temp"' EXIT
sed "s|/usr/lib/roccat/src/lighting_service.py|\"$root/src/lighting_service.py\"|" "$source" > "$temp"
[ -f "$root/src/lighting_service.py" ]
old_enabled=$(systemctl --user is-enabled "$unit" 2>/dev/null || :)
old_active=$(systemctl --user is-active "$unit" 2>/dev/null || :)
backup=
if [ -e "$target" ]; then
    backup=$(mktemp "$target.backup-XXXXXX")
    cp -p -- "$target" "$backup"
fi
systemctl --user stop "$unit" 2>/dev/null || [ -z "$old_enabled" ] || [ "$old_enabled" = not-found ]
mv -f -- "$temp" "$target"
if systemctl --user daemon-reload && systemctl --user enable "$unit" && systemctl --user start "$unit" &&
    systemctl --user is-active --quiet "$unit"; then
    [ -z "$backup" ] || printf 'Sicherung / Backup %s\n' "$backup"
    exit 0
fi
systemctl --user disable --now "$unit" || :
if [ -n "$backup" ]; then
    cp -p -- "$backup" "$target"
else
    rm -f -- "$target"
fi
systemctl --user daemon-reload
case "$old_enabled" in enabled*) systemctl --user enable "$unit" ;; esac
[ "$old_active" != active ] || systemctl --user start "$unit"
exit 1
